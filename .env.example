# Copy to .env.local and edit. .env.local is gitignored and must stay that way.
#
# Both variables are NEXT_PUBLIC_, which means Next.js inlines them into the
# browser bundle. Never put a secret in a NEXT_PUBLIC_ variable — anyone can
# read it in devtools. Secrets belong on the API side.

# Base URL of the FastAPI backend, no trailing slash.
# Ignored when NEXT_PUBLIC_USE_MOCKS=true.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to serve lib/mocks.ts instead of calling the API, so the
# frontend runs with no backend at all. Any other value means live API.
# Must be "false" for the deployed build.
NEXT_PUBLIC_USE_MOCKS=true
